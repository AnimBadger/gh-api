{
  "name": "@gh-api/sms",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "playwright test --config=../../playwright.config.ts test/",
    "test:watch": "playwright test --config=../../playwright.config.ts --ui test/"
  },
  "dependencies": {
    "@gh-api/core": "*"
  },
  "devDependencies": {
    "tsup": "^8.4.0"
  }
}
